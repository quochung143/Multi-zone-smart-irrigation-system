CONFIG_IDF_TARGET="esp32"
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_FREERTOS_HZ=1000
CONFIG_ESP_TASK_WDT_TIMEOUT_S=5
# Task treo thì reset chip thay vì chỉ in cảnh báo
CONFIG_ESP_TASK_WDT_PANIC=y
CONFIG_ESP_CONSOLE_UART_BAUDRATE=115200
# UART0 là console cấu hình (dữ liệu đi MQTT). Log mặc định WARN vì Wi-Fi in rất nhiều;
# module của gateway tự bật INFO lúc chạy nên mức tối đa phải là INFO
CONFIG_LOG_DEFAULT_LEVEL_WARN=y
CONFIG_LOG_MAXIMUM_LEVEL_INFO=y
CONFIG_BOOTLOADER_LOG_LEVEL_WARN=y
# Wi-Fi + MQTT + mDNS + TFT vượt 1 MB: dùng phân vùng app 1.5 MB (không OTA)
CONFIG_PARTITION_TABLE_SINGLE_APP_LARGE=y
# Broker trong LAN, không dùng TLS/WebSocket
CONFIG_MQTT_TRANSPORT_SSL=n
CONFIG_MQTT_TRANSPORT_WEBSOCKET=n
