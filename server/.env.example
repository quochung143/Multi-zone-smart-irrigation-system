# Broker Mosquitto trên laptop (server/mosquitto/mosquitto.conf)
MQTT_HOST=localhost
MQTT_PORT=1883
MQTT_USER=server
MQTT_PASS=doi-mat-khau-nay

# MongoDB 7.x; dùng memory:// để chạy thử không cần MongoDB (mất dữ liệu khi tắt)
MONGO_URI=mongodb://localhost:27017
DB_NAME=irrigation

HTTP_PORT=8000

# Đăng nhập dashboard. Để trống DASH_PASS thì không hỏi mật khẩu (chỉ dùng trong máy).
# BẮT BUỘC đặt khi mở dashboard qua Cloudflare Tunnel (api.quochung.xyz).
DASH_USER=admin
DASH_PASS=
